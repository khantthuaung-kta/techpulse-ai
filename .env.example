# Bot token issued by Telegram's BotFather.
TELEGRAM_BOT_TOKEN=

# Numeric chat ID or @channelusername for a public channel.
TELEGRAM_CHAT_ID=

# Optional summaries. Select gemini or groq, or leave empty to disable.
AI_PROVIDER=
# Optional override. Defaults to the supported model for the selected provider.
AI_MODEL=
GEMINI_API_KEY=
# Set true only for a Google AI Studio project with no linked billing account.
GEMINI_FREE_TIER_CONFIRMED=false
GROQ_API_KEY=
# Set true only when the key belongs to a GroqCloud Free-plan organization.
GROQ_FREE_TIER_CONFIRMED=false
# Optional local SQLite cache. Use a persistent path for reuse across runs.
AI_SUMMARY_CACHE=
